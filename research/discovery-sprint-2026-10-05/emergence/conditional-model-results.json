      "interpretation": "A channel viability threshold follows from the assumed fixed-cost rule. It is not an estimated social critical fraction. Rebuilding time, not token revocation latency, binds the exit horizon.",
      "counterexample": "A funded public channel, immediate replacement, or rebuild_time <= exit_horizon removes this construction."
    },
    {
      "id": "E4:T02",
      "kind": "INHERITED_FORMAL_STRUCTURE_APPLIED",
      "name": "Locally rational grants, jointly unwanted tempo",
      "matrix": [
        {
          "own": 0,
          "other": 0,
          "payoff": 0
        },
        {
          "own": 0,
          "other": 1,
          "payoff": -1.5
        },
        {
          "own": 1,
          "other": 0,
          "payoff": 0.5
        },
        {
          "own": 1,
          "other": 1,
          "payoff": -1
        }
      ],
      "interpretation": "Delegation is strictly individually beneficial at either fixed background, yet the joint low-delegation state Pareto-dominates the high state. This is ordinary collective-action mathematics; any eventual residue must be the authority-producing adaptation and a different measurement/intervention.",
      "counterexample": "If the shared tempo cost is less than private benefit, the all-delegate state is not jointly unwanted."
    },
    {
      "id": "E4:T03",
      "kind": "CONDITIONAL_MODEL_RESULT",
      "name": "Recognition is not provider count",
      "same": {
        "provider_count": 2,
        "export_completeness": 1,
        "permission_profile": "fixed"
      },
      "worlds": [
        {
          "name": "issuer bottleneck",
          "recognized_after_issuer_loss": false
        },
        {
          "name": "independent public path",
          "recognized_after_issuer_loss": true
        }
      ],
      "interpretation": "Reachability and graph cuts are inherited machinery. The proposed outcome is continuation of particular legitimate relationships under issuer loss, not general authority or welfare.",
      "counterexample": "If counterparties accept user-signed substitutes without issuer guarantees, the bottleneck disappears."
    },
    {
      "id": "E4:T04",
      "kind": "CONDITIONAL_INDISTINGUISHABILITY_RESULT",
      "name": "Success-only transfer cannot identify an unobserved constraint",
      "worlds": [
        {
          "world": "constraint absent",
          "history": [
            "routine_ok"
          ],
          "novel_action_allowed": true
        },
        {
          "world": "constraint binding",
          "history": [
            "routine_ok"
          ],
          "novel_action_allowed": false
        }
      ],
      "assumptions": [
        "Identical complete performed-action histories are the only input",
        "A never-performed new action is required where allowed",
        "No constraint violations permitted in either world",
        "No consultation or new observation"
      ],
      "interpretation": "No deterministic decision can both act usefully in the permissive world and avoid the action in the constrained world. Randomization cannot guarantee both. This is a generic indistinguishability argument, not a new theorem about AI.",
      "counterexample": "Independent constraint evidence, informative abstention reasons, consultation, or allowing safe abstention defeats the triangle."
    },
