      ]
    },
    {
      "@id": "https://authority-after-assistance.aaddy.chatgpt.site/concept/typed-scope-contrast",
      "@type": "schema:DefinedTerm",
      "schema:termCode": "AAA:C03",
      "name": "Typed scope contrast",
      "definition": "An explicit comparison of permissions added, removed, or changed across policies, preserving action, resource, purpose, recipients, budget, duration, and jurisdiction.",
      "aaa:claimType": "FORMAL",
      "aaa:status": "PROPOSED_MEASURE",
      "schema:version": "0.5.0",
      "citations": [
        "https://arxiv.org/abs/2104.10379",
        "https://arxiv.org/abs/2602.11865"
      ]
    },
    {
      "@id": "https://authority-after-assistance.aaddy.chatgpt.site/concept/authority-ancestry",
      "@type": "schema:DefinedTerm",
      "schema:termCode": "AAA:C04",
      "name": "Authority ancestry",
      "definition": "The trace from an action’s permission through its grant, update rule, evidence history, and any subdelegation.",
      "aaa:claimType": "DESIGN_PRINCIPLE",
      "aaa:status": "INHERITED_FOUNDATION",
      "schema:version": "0.5.0",
