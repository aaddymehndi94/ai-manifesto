    {
      "@id": "https://authority-after-assistance.aaddy.chatgpt.site/principle/audit-evidence-authority",
      "@type": "schema:CreativeWork",
      "schema:identifier": "AAA:P01",
      "name": "Audit the evidence that updates authority",
      "definition": "Authenticate the grant; replay the exact rule; estimate or bound the total intervention-policy contrast in typed future scope; return governance judgment separately.",
      "aaa:claimType": "DESIGN_PRINCIPLE",
      "aaa:status": "PROPOSED_EXTENSION",
      "schema:version": "0.5.0",
      "citations": [
        "https://proceedings.mlr.press/v119/perdomo20a.html",
        "https://proceedings.mlr.press/v162/carroll22a.html",
        "https://arxiv.org/abs/2609.01836",
        "https://arxiv.org/abs/2104.10379"
      ]
    },
    {
      "@id": "https://authority-after-assistance.aaddy.chatgpt.site/principle/terms-of-chosen-change",
      "@type": "schema:CreativeWork",
      "schema:identifier": "AAA:P02",
      "name": "Specify the terms of chosen change",
      "definition": "Do not equate influence with illegitimacy. Bind formation purpose, intervention classes, scope criteria, review triggers, and locally valid ratification procedures when conditional authority depends on human-state signals.",
      "aaa:claimType": "NORMATIVE",
      "aaa:status": "INHERITED_WITH_IMPLEMENTATION_PROPOSAL",
      "schema:version": "0.5.0",
      "citations": [
