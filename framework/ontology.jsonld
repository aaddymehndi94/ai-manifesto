        "https://arxiv.org/abs/2104.10379"
      ]
    },
    {
      "@id": "https://authority-after-assistance.aaddy.chatgpt.site/concept/recovery-after-assistance",
      "@type": "schema:DefinedTerm",
      "schema:termCode": "AAA:C05",
      "name": "Recovery after assistance",
      "definition": "The capabilities, alternatives, and transition costs available after a person or institution reduces reliance on assistance.",
      "aaa:claimType": "EMPIRICAL",
      "aaa:status": "INHERITED_RESEARCH_QUESTION",
