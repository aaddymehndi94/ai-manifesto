        "https://selfdeterminationtheory.org/SDT/documents/2000_RyanDeci_SDT.pdf",
        "https://doi.org/10.3389/frobt.2018.00015"
      ]
    },
    {
      "@id": "https://authority-after-assistance.aaddy.chatgpt.site/principle/evaluate-after-help",
      "@type": "schema:CreativeWork",
      "schema:identifier": "AAA:P03",
      "name": "Evaluate what remains after help",
      "definition": "Measure assisted success, transfer capacity, alternatives, review burden, and shared-resource effects separately. Treat access needs and chosen dependence explicitly. Keep artificial welfare uncertainty analytically distinct.",
      "aaa:claimType": "DESIGN_PRINCIPLE",
      "aaa:status": "INHERITED_FOUNDATION",
