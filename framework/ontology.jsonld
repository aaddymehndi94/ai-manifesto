    },
    {
      "@id": "https://authority-after-assistance.aaddy.chatgpt.site/concept/conditional-influence-contract",
      "@type": "schema:DefinedTerm",
      "schema:termCode": "AAA:C02",
      "name": "Conditional influence contract",
      "definition": "A conditional grant specification that states which intervention classes may contribute evidence to updates of the delegate’s own action scope.",
      "aaa:claimType": "DESIGN_PRINCIPLE",
      "aaa:status": "SUPPORTING_SYNTHESIS",
      "schema:version": "0.5.0",
